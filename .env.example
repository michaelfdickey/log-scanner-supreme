# Copy this file to .env and add your GitHub Personal Access Token

# GitHub Personal Access Token with Copilot access
# Classic tokens: ghp_...
# Fine-grained tokens: github_pat_...
GITHUB_PAT=your-github-pat-here

# Model to use (default: gpt-4o-mini)
# Options: gpt-4o, gpt-4o-mini, gpt-4, gpt-3.5-turbo
COPILOT_MODEL=gpt-4o-mini

# Chunk size in tokens (default: 3000)
CHUNK_SIZE=3000
